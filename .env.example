# Docker image tag.
SERVICE_VERSION=latest
# Host port published by Docker Compose.
SERVICE_PORT=29652
# Origins allowed to frame the dashboard (ServiceHub), space separated. Add the hub's IP form if you open it that way.
SERVICE_FRAME_ANCESTORS=http://scutiserver1.local:29880
# Encryption key for stored provider keys. Generate with openssl rand -hex 32.
# Required: the service does not start without it. Keep a separate backup; losing it loses the stored keys.
ENCRYPTION_KEY=your-64-char-hex-key-here
